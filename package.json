{
  "name": "codex-graph",
  "version": "0.1.0",
  "description": "A Codex skill and local JS/TS codebase knowledge graph engine.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "bin": {
    "codex-graph": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "skill-template/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/cli.ts --format esm --dts --clean --sourcemap",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "package:dry-run": "npm pack --dry-run",
    "prepack": "pnpm build && pnpm typecheck && pnpm test"
  },
  "keywords": [
    "codex",
    "codebase",
    "graph",
    "typescript",
    "javascript",
    "mcp",
    "agent",
    "skill"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.0",
    "commander": "^14.0.2",
    "fast-glob": "^3.3.3",
    "ignore": "^7.0.5",
    "toml": "^3.0.0",
    "ts-morph": "^27.0.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^4.0.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
